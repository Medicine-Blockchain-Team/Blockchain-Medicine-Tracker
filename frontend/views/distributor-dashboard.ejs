<%- include('partials/header', { title: 'Distributor Dashboard', user, active: 'dashboard' }) %>

<div class="row g-4">

  <!-- HEADER -->
  <div class="col-12">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h3 class="mb-1">Distributor Dashboard</h3>
        <p class="text-muted mb-0">
          Manage medicines you hold and transfer them to suppliers.
        </p>
      </div>
    </div>
  </div>

  <!-- MAIN CARD -->
  <div class="col-12">
    <div class="card shadow-sm border-0">
      <div class="card-body">

        <h5 class="card-title mb-3">Medicines in Your Custody</h5>

        <% if (!drugs || drugs.length === 0) { %>
          <div class="alert alert-info mb-0">
            You currently have no medicines assigned as distributor.
          </div>
        <% } else { %>

          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead class="table-light">
                <tr>
                  <th>#</th>
                  <th>Drug ID</th>
                  <th>Name</th>
                  <th>Manufacturer</th>
                  <th>Status</th>
                  <th>Transfer to Supplier</th>
                </tr>
              </thead>
              <tbody>
                <% drugs.forEach((drug, index) => { %>
                  <tr>
                    <td><%= index + 1 %></td>
                    <td><code><%= drug.id %></code></td>
                    <td><%= drug.name %></td>
                    <td><%= drug.manufacturer %></td>
                    <td>
                      <span class="badge bg-secondary">
                        <%= drug.status || 'With Distributor' %>
                      </span>
                    </td>
                    <td>
                      <% if (suppliers && suppliers.length > 0) { %>
                        <form
                          action="/api/drugs/transfer-to-supplier"
                          method="POST"
                          class="d-flex gap-2 transfer-to-supplier-form"

                        >
                          <input type="hidden" name="drugId" value="<%= drug.id %>" />

                          <select
                            name="supplierName"
                            class="form-select form-select-sm"
                            required
                          >
                            <% suppliers.forEach(s => { %>
                              <option value="<%= s.username %>">
                                <%= s.username %>
                              </option>
                            <% }) %>
                          </select>

                          <button type="submit" class="btn btn-sm btn-primary">
                            Transfer
                          </button>
                        </form>
                      <% } else { %>
                        <span class="text-muted small">
                          No suppliers registered.
                        </span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

        <% } %>

      </div>
    </div>
  </div>

</div>
<script>
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.transfer-to-supplier-form').forEach(form => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = form.querySelector("button[type='submit']");
      const origText = submitBtn ? submitBtn.textContent : null;
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Transferring...'; }

      const fd = new FormData(form);
      const payload = {
        drugId: fd.get('drugId'),
        supplierName: fd.get('supplierName')
      };

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          credentials: 'same-origin',   // important: include session cookie
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || data.message || `Server error ${res.status}`);
        // success: reload or update UI
        window.location.reload();
      } catch (err) {
        alert('Transfer failed: ' + (err.message || 'Unknown error'));
        console.error('Transfer-to-supplier error:', err);
      } finally {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = origText || 'Transfer'; }
      }
    });
  });
});
</script>


<%- include('partials/footer') %>
